# Bu dosyayı `.env` olarak kopyala ve değerleri doldur. `.env` commit EDİLMEZ.
#
#   cp .env.example .env        (bash)
#   copy .env.example .env      (cmd)

# LiteLLM sanal anahtarı. Zorunlu -- ama yalnız LiteLLM yolunda:
# `--docker` ile sunucunun üstünden gidersen auth devrede olmadığı için gerekmez.
SYSTEMONE_API_KEY=

# LiteLLM ağ geçidi. SPARK_IP yerine kendi sunucunun adresini yaz -- bu satır
# doldurulmadan hiçbir Spark kolu çalışmaz. IP'si DHCP ile değişen bir makineyse
# mDNS adıyla da verebilirsin (ör. http://sunucu.local:4000/v1).
SYSTEMONE_BASE_URL=http://SPARK_IP:4000/v1

# Birinci Spark kolu (`spark`). Servis edilen model adı.
SYSTEMONE_MODEL=qwen3.8-27b

# İkinci Spark kolu (`gemma`) -- aynı ağ geçidi, farklı model. Karşılaştırmada
# ayrı sütun olarak görünür. Servis edilmiyorsa --motor ile dışarıda bırak.
SYSTEMONE_GEMMA_MODEL=gemma4-26b

# --docker yolunda hedef konteyner: vllm | vllm-gemma
SYSTEMONE_CONTAINER=vllm

# ---------------------------------------------------------------------------
# Jev / TypeSafe -- karşılaştırmanın ikinci kolu (karsilastir/, web/).
# Yalnız karşılaştırma için gerekir; duman testi ve `score` bu anahtar olmadan
# da çalışır. jev-test deposundakiyle aynı anahtar.
#
# Anahtar: https://console.typesafe.ai/
TYPESAFE_API_KEY=

# Alias `jev-latest` yeni sürüm çıktıkça kayar. Bir ölçümü donduracaksan
# `jev-1.13.0` gibi sabit bir id yaz, yoksa sayılar sessizce değişir.
JEV_MODEL=jev-latest

# ---------------------------------------------------------------------------
# Laya -- açık ağırlıklı encoder karar modeli, bu makinede koşar (anahtar yok).
# İsteğe bağlı: `pip install laya` (torch'u da getirir). Kurulu değilse kol devre
# dışı kalır. İlk açılışta ağırlıklar Hugging Face'ten iner (~600 MB).
#
# Biçim: sahip/repo/alt_klasör. Türkçe için multilingual checkpoint.
LAYA_MODEL=convaiinnovations/laya/multilingual
# Boşsa otomatik (cuda -> mps -> cpu). Zorlamak için: cpu | cuda
LAYA_DEVICE=

# ---------------------------------------------------------------------------
# clef-flash -- Cloudflare'ın 9B karar modeli, Spark'ta İSTEĞE BAĞLI konteynerde
# (`~/clef-flash/baslat.sh` / `docker stop clef-flash`; düz `docker start` bellek
# bekçisini atlar). Jev'le aynı gövde.
# Boşsa kol devre dışı. Konteyner kapalıyken kol kurulur, istekler hata döner.
CLEF_URL=http://SPARK_IP:8101
